{
  "id": "pvm",
  "name": "PVM HLC (Pico VM)",
  "description": "Высокоуровневый язык стековой виртуальной машины PVM для микроконтроллеров. Сборкой (pvmcc, pvmc), запуском и отладкой (pvmsim, pvmdbg) управляет VisualIDE.",
  "fileExtension": "hlc",
  "fileName": "main.hlc",
  "editorLanguage": "c",
  "indent": "    ",
  "lineComment": "//",
  "reservedWords": [
    "int",
    "void",
    "volatile",
    "const",
    "if",
    "else",
    "while",
    "do",
    "for",
    "return",
    "halt",
    "svc",
    "import",
    "extern",
    "from",
    "sizeof",
    "section",
    "main",
    "code",
    "ram",
    "stack",
    "usrsect",
    "Time_GetTick",
    "Time_Elapsed",
    "Time_Delay",
    "VideMod",
    "VidePow",
    "VideAbs",
    "VideSqrt",
    "VideConstrain",
    "VideRandom",
    "VideSeed",
    "VideIsPrime"
  ],
  "types": {
    "Number": "int",
    "Boolean": "int",
    "String": "int",
    "Integer": "int",
    "List": "int",
    "Void": "void"
  },
  "defaults": {
    "Number": "0",
    "Boolean": "0",
    "String": "0",
    "List": "0"
  },
  "nakedValue": "// значение без использования: {{CODE}}",
  "variables": {
    "declaration": "int {{NAME}};"
  },
  "functions": {
    "param": "int {{NAME}}",
    "paramSeparator": ", ",
    "noReturn": [
      "void {{NAME}}({{PARAMS}}) {",
      "{{BODY}}}"
    ],
    "withReturn": [
      "int {{NAME}}({{PARAMS}}) {",
      "{{BODY}}    return {{RETURN}};",
      "}"
    ]
  },
  "program": [
    "// Сгенерировано VisualIDE (PVM HLC)",
    "{{WARNINGS}}",
    "{{HELPERS}}",
    "",
    "{{VARIABLES}}",
    "",
    "{{FUNCTIONS}}",
    "",
    "void main() {",
    "{{BODY|indent}}}"
  ],
  "helpers": {
    "time": "import time;",
    "mod": [
      "int VideMod(int a, int b) {",
      "    return a - a / b * b;",
      "}"
    ],
    "pow": [
      "int VidePow(int a, int b) {",
      "    int r;",
      "    r = 1;",
      "    while (b > 0) {",
      "        r = r * a;",
      "        b = b - 1;",
      "    }",
      "    return r;",
      "}"
    ],
    "abs": [
      "int VideAbs(int x) {",
      "    return x < 0 ? -x : x;",
      "}"
    ],
    "sqrt": [
      "int VideSqrt(int x) {",
      "    int r;",
      "    r = 0;",
      "    while (r < 181 && (r + 1) * (r + 1) <= x) {",
      "        r = r + 1;",
      "    }",
      "    return r;",
      "}"
    ],
    "constrain": [
      "int VideConstrain(int v, int lo, int hi) {",
      "    return v < lo ? lo : (v > hi ? hi : v);",
      "}"
    ],
    "random": {
      "requires": [
        "mod"
      ],
      "code": [
        "int VideSeed = 12345;",
        "",
        "int VideRandom(int a, int b) {",
        "    VideSeed = VideSeed * 25173 + 13849;",
        "    return a + VideMod((VideSeed >> 1) & 0x7FFF, b - a + 1);",
        "}"
      ]
    },
    "prime": {
      "requires": [
        "mod"
      ],
      "code": [
        "int VideIsPrime(int n) {",
        "    int d;",
        "    if (n < 2) {",
        "        return 0;",
        "    }",
        "    d = 2;",
        "    while (d <= 181 && d * d <= n) {",
        "        if (VideMod(n, d) == 0) {",
        "            return 0;",
        "        }",
        "        d = d + 1;",
        "    }",
        "    return 1;",
        "}"
      ]
    }
  },
  "blocks": {
    "controls_if": {
      "if": "if ({{IF}}) {\n{{DO}}}",
      "elseif": " else if ({{IF}}) {\n{{DO}}}",
      "else": " else {\n{{DO}}}"
    },
    "controls_repeat_ext": {
      "template": "for ({{$TEMP:count}} = 0; {{$TEMP:count}} < {{TIMES}}; {{$TEMP:count}}++) {\n{{DO}}}",
      "argOrder": 7
    },
    "controls_whileUntil": {
      "switch": "MODE",
      "cases": {
        "WHILE": "while ({{BOOL}}) {\n{{DO}}}",
        "UNTIL": {
          "template": "while (!{{BOOL}}) {\n{{DO}}}",
          "argOrder": 1
        }
      }
    },
    "controls_for": {
      "template": "for ({{VAR}} = {{FROM}}; {{VAR}} <= {{TO}}; {{VAR}} += {{BY}}) {\n{{DO}}}",
      "argOrder": 7
    },
    "logic_boolean": {
      "switch": "BOOL",
      "cases": {
        "TRUE": "1",
        "FALSE": "0"
      }
    },
    "logic_compare": {
      "switch": "OP",
      "cases": {
        "EQ": {
          "template": "{{A}} == {{B}}",
          "order": 9
        },
        "NEQ": {
          "template": "{{A}} != {{B}}",
          "order": 9
        },
        "LT": {
          "template": "{{A}} < {{B}}",
          "order": 8
        },
        "LTE": {
          "template": "{{A}} <= {{B}}",
          "order": 8
        },
        "GT": {
          "template": "{{A}} > {{B}}",
          "order": 8
        },
        "GTE": {
          "template": "{{A}} >= {{B}}",
          "order": 8
        }
      }
    },
    "logic_operation": {
      "switch": "OP",
      "cases": {
        "AND": {
          "template": "{{A}} && {{B}}",
          "order": 10
        },
        "OR": {
          "template": "{{A}} || {{B}}",
          "order": 11
        }
      }
    },
    "logic_negate": {
      "template": "!{{BOOL}}",
      "order": 1
    },
    "logic_ternary": {
      "template": "{{IF}} ? {{THEN}} : {{ELSE}}",
      "order": 12
    },
    "math_number": "{{NUM|int}}",
    "math_arithmetic": {
      "switch": "OP",
      "cases": {
        "ADD": {
          "template": "{{A}} + {{B}}",
          "order": 3
        },
        "MINUS": {
          "template": "{{A}} - {{B}}",
          "order": 3
        },
        "MULTIPLY": {
          "template": "{{A}} * {{B}}",
          "order": 2
        },
        "DIVIDE": {
          "template": "{{A}} / {{B}}",
          "order": 2
        },
        "POWER": {
          "template": "VidePow({{A}}, {{B}})",
          "requires": "pow"
        }
      }
    },
    "math_single": {
      "switch": "OP",
      "cases": {
        "ROOT": {
          "template": "VideSqrt({{NUM}})",
          "requires": "sqrt"
        },
        "ABS": {
          "template": "VideAbs({{NUM}})",
          "requires": "abs"
        },
        "NEG": {
          "template": "-{{NUM}}",
          "order": 1
        }
      }
    },
    "math_round": {
      "template": "{{NUM}}",
      "order": 12
    },
    "math_modulo": {
      "template": "VideMod({{DIVIDEND}}, {{DIVISOR}})",
      "requires": "mod"
    },
    "math_constrain": {
      "template": "VideConstrain({{VALUE}}, {{LOW}}, {{HIGH}})",
      "requires": "constrain"
    },
    "math_random_int": {
      "template": "VideRandom({{FROM}}, {{TO}})",
      "requires": "random"
    },
    "math_number_property": {
      "switch": "PROPERTY",
      "cases": {
        "EVEN": {
          "template": "VideMod({{NUMBER_TO_CHECK}}, 2) == 0",
          "order": 9,
          "argOrder": 99,
          "requires": "mod"
        },
        "ODD": {
          "template": "VideMod({{NUMBER_TO_CHECK}}, 2) != 0",
          "order": 9,
          "argOrder": 99,
          "requires": "mod"
        },
        "WHOLE": "1",
        "POSITIVE": {
          "template": "{{NUMBER_TO_CHECK}} > 0",
          "order": 8
        },
        "NEGATIVE": {
          "template": "{{NUMBER_TO_CHECK}} < 0",
          "order": 8
        },
        "DIVISIBLE_BY": {
          "template": "VideMod({{NUMBER_TO_CHECK}}, {{DIVISOR}}) == 0",
          "order": 9,
          "argOrder": 99,
          "requires": "mod"
        },
        "PRIME": {
          "template": "VideIsPrime({{NUMBER_TO_CHECK}})",
          "requires": "prime"
        }
      }
    },
    "math_change": "{{VAR}} += {{DELTA}};",
    "text_print": {
      "switchType": "TEXT",
      "cases": {
        "Number": "svc(1, {{TEXT}});",
        "Boolean": "svc(1, {{TEXT}});"
      }
    },
    "variables_get": "{{VAR}}",
    "variables_set": "{{VAR}} = {{VALUE}};",
    "procedures_callreturn": {
      "repeat": "ARG",
      "template": "{{NAME}}({{ITEMS}})"
    },
    "procedures_callnoreturn": {
      "repeat": "ARG",
      "template": "{{NAME}}({{ITEMS}});"
    },
    "procedures_ifreturn": {
      "switch": "$HAS_RETURN",
      "cases": {
        "true": "if ({{CONDITION}}) {\n{{$INDENT}}return {{VALUE}};\n}",
        "false": "if ({{CONDITION}}) {\n{{$INDENT}}return;\n}"
      }
    },
    "pvm_port_set": {
      "template": "{{NAME}} = {{VALUE}};",
      "declare": "volatile int {{NAME}} @ {{ADDR}};"
    },
    "pvm_port_get": {
      "template": "{{NAME}}",
      "declare": "volatile int {{NAME}} @ {{ADDR}};"
    },
    "pvm_svc": {
      "switch": "$CONNECTED:B",
      "cases": {
        "true": "svc({{N}}, {{A}}, {{B}});",
        "false": {
          "switch": "$CONNECTED:A",
          "cases": {
            "true": "svc({{N}}, {{A}});",
            "false": "svc({{N}});"
          }
        }
      }
    },
    "pvm_svc_value": {
      "switch": "$CONNECTED:B",
      "cases": {
        "true": "svc({{N}}, {{A}}, {{B}})",
        "false": {
          "switch": "$CONNECTED:A",
          "cases": {
            "true": "svc({{N}}, {{A}})",
            "false": "svc({{N}})"
          }
        }
      }
    },
    "pvm_bit_op": {
      "switch": "OP",
      "cases": {
        "AND": {
          "template": "{{A}} & {{B}}",
          "order": 5
        },
        "XOR": {
          "template": "{{A}} ^ {{B}}",
          "order": 6
        },
        "OR": {
          "template": "{{A}} | {{B}}",
          "order": 7
        },
        "SHL": {
          "template": "{{A}} << {{B}}",
          "order": 4
        },
        "SHR": {
          "template": "{{A}} >> {{B}}",
          "order": 4
        }
      }
    },
    "pvm_bit_not": {
      "template": "~{{NUM}}",
      "order": 1
    },
    "pvm_tick": {
      "template": "Time_GetTick()",
      "requires": "time"
    },
    "pvm_delay": {
      "template": "Time_Delay({{TICKS}});",
      "requires": "time"
    },
    "pvm_halt": "halt;",
    "pvm_section": {
      "template": "",
      "declare": "section {{KIND}} {{SIZE}};"
    },
    "vide_comment": "// {{TEXT}}",
    "vide_raw_code": "{{CODE}}",
    "vide_raw_expr": {
      "template": "{{CODE}}",
      "order": 99
    }
  },
